# Ключ API вашего LLM-провайдера (обязательный). В git не попадает (.gitignore).
OPENAI_API_KEY=sk-your-key-here

# Модель для всех вызовов (опционально, по умолчанию deepseek-v4-flash).
OPENAI_MODEL=deepseek-v4-flash

# Base URL OpenAI-совместимого API (опционально, пример ниже).
OPENAI_BASE_URL=https://gpustack.data.lmru.tech/v1
